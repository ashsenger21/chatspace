# ChatSpace - Environment Variables
# Copy this file to .env and fill in your values.
# NEVER commit .env to Git.

# -------------------------------------------------------------------
# Flask secret key (change this to a long random string in production)
# -------------------------------------------------------------------
SECRET_KEY=change-this-to-a-long-random-string

# -------------------------------------------------------------------
# Database
# Leave blank for local SQLite. Render sets this automatically.
# -------------------------------------------------------------------
DATABASE_URL=

# -------------------------------------------------------------------
# Cloudinary (free at https://cloudinary.com)
# Required for photo/video/audio uploads in production.
# -------------------------------------------------------------------
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# -------------------------------------------------------------------
# Flask environment
# -------------------------------------------------------------------
FLASK_ENV=production
